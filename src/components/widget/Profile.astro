---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const avatar = config.avatar || "";
const name = config.name;
const bio = config.bio || "";
const links = config.links || [];
---
<div id="profile-card" class="card-base p-3 relative">
    <button id="edit-profile-btn" class="profile-edit-btn login-only" aria-label="Edit profile"
            style="display:none;position:absolute;top:8px;right:8px;z-index:10;width:28px;height:28px;border:none;border-radius:6px;background:var(--btn-regular-bg);color:var(--btn-content);cursor:pointer;align-items:center;justify-content:center;font-size:14px;"
            title="编辑个人信息">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
    </button>
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-[12rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper id="profile-avatar-img" src={avatar} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="px-2">
        <div id="profile-name" class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{name}</div>
        <div class="h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-2 transition"></div>
        <div id="profile-bio" class="text-center text-neutral-400 mb-2.5 transition">{bio}</div>
        <div id="profile-social" class="flex flex-wrap gap-2 justify-center mb-1">
            {links.length > 1 && links.map(item =>
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-10 w-10 active:scale-90">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                    </a>
            )}
            {links.length == 1 && <a rel="me" aria-label={links[0].name} href={links[0].url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                <Icon name={links[0].icon} class="text-[1.5rem]"></Icon>
                {links[0].name}
            </a>}
        </div>
    </div>
</div>

<script>
(function() {
  function loadProfile() {
    try {
      const raw = localStorage.getItem('blog-profile');
      if (!raw) return;
      const p = JSON.parse(raw);
      if (p.name) {
        const el = document.getElementById('profile-name');
        if (el) el.textContent = p.name;
      }
      if (p.bio) {
        const el = document.getElementById('profile-bio');
        if (el) el.textContent = p.bio;
      }
      if (p.avatar) {
        const el = document.getElementById('profile-avatar-img');
        if (el) {
          // Find the actual <img> inside ImageWrapper
          const img = el.querySelector('img');
          if (img) img.src = p.avatar;
        }
      }
      if (p.social && p.social.length) {
        const container = document.getElementById('profile-social');
        if (container) {
          container.innerHTML = p.social.map(s =>
            `<a rel="me" aria-label="${s.platform}" href="${s.url}" target="_blank" class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95 flex items-center">
              <span>${s.platform}</span>
            </a>`
          ).join('');
        }
      }
    } catch(e) { /* ignore */ }
  }
  document.addEventListener('DOMContentLoaded', loadProfile);
  window.addEventListener('profile-updated', loadProfile);

  // Edit button — only show when logged in
  function toggleEditButtons() {
    const loggedIn = !!localStorage.getItem('github_token');
    const editBtns = document.querySelectorAll('.login-only');
    editBtns.forEach(el => {
      (el as HTMLElement).style.display = loggedIn ? '' : 'none';
    });
  }
  toggleEditButtons();
  window.addEventListener('login-done', toggleEditButtons);

  // Edit profile button
  const editBtn = document.getElementById('edit-profile-btn');
  if (editBtn) {
    editBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (!localStorage.getItem('github_token')) {
        window.dispatchEvent(new CustomEvent('open-login'));
        return;
      }
      window.dispatchEvent(new CustomEvent('open-profile-editor'));
    });
  }
})();
</script>

